#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/_lib.sh"

if should_remote python "$@"; then
  exec "$(worker_bin)" run python "$@"
fi
REAL="$(real_bin python)" || { echo "python not found on Mac" >&2; exit 127; }
exec "$REAL" "$@"
