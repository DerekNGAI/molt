#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/_lib.sh"

if should_remote python3 "$@"; then
  exec "$(molt_bin)" run python3 "$@"
fi
REAL="$(real_bin python3)" || { echo "python3 not found on Mac" >&2; exit 127; }
exec "$REAL" "$@"
