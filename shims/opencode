#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
MOLT="${MOLT_HOME:-$HERE}/bin/molt"
if [[ "${MOLT_LOCAL:-0}" == 1 ]]; then exec "$MOLT" client "$@"; fi
case "${1:-}" in
  auth|models|run)
    if project_id="$("$MOLT" project-find "$PWD" 2>/dev/null)"; then exec "$MOLT" remote-oc "@$project_id" "$@"; fi ;;
  attach|serve|web|--help|-h|--version|-v|upgrade|uninstall|completion|debug|mcp|export|import|session|stats|github|pr|agent)
    exec "$MOLT" client "$@" ;;
esac
search="$PWD"
if [[ -n "${1:-}" && "$1" != -* && -d "$1" ]]; then search="$1"; fi
if "$MOLT" project-find "$search" >/dev/null 2>&1; then exec "$MOLT" oc "$@"; fi
exec "$MOLT" client "$@"
