#!/usr/bin/expect -f
# Fresh native installation, shell activation, VM setup, and complete uninstall.
set timeout 25
log_user 0
proc see {text} {
  global spawn_id expect_out
  expect {
    -ex $text { return }
    timeout { puts stderr "FAIL: native setup did not show '$text'\n$expect_out(buffer)"; exit 1 }
    eof { puts stderr "FAIL: native setup exited before '$text'"; exit 1 }
  }
}
proc enter {} { global spawn_id; send -- "\r"; after 180 }
proc down {count} { global spawn_id; for {set i 0} {$i<$count} {incr i} {send -- "\033\[B"; after 80} }
proc value {text} { global spawn_id; send -- "\025$text\r"; after 180 }
proc escape {} { global spawn_id; send -- "\033"; after 250 }
proc palette {index} { global spawn_id; send -- ":"; see "COMMANDS"; down $index; enter }
spawn -noecho /bin/bash "$env(TUI_ROOT)/tests/terminal_check.sh" /bin/bash "$env(TUI_ROOT)/install.sh" --interactive
stty rows 32 columns 100 < $spawn_out(slave,name)
see "INSTALL FOLDER"
enter
see "INSTALL MOLT?"
send -- "y"
see "MOLT INSTALLED"
enter
see "GUIDED SETUP"
set command [exec /bin/zsh -ic {command -v molt}]
if {$command!="$env(MOLT_HOME)/bin/molt"} { puts stderr "FAIL: native installation did not enable shell activation"; exit 1 }
escape
see "WORKSPACES"
send -- "q"
expect eof
catch wait result
if {[lindex $result 3]!=0} { puts stderr "FAIL: closing the installer returned $result"; exit 1 }
spawn -noecho /bin/bash "$env(TUI_ROOT)/tests/terminal_check.sh" /bin/zsh -ic molt
stty rows 32 columns 100 < $spawn_out(slave,name)
see "WORKSPACES"
palette 1
see "CONNECTIONS"
enter
see "CONNECTION PROFILE"
see "Connection name"
enter
see "VM address"
value "vm.example"
see "SSH username"
enter
see "SSH port"
enter
see "Identity file"
value "$env(TUI_TMP)/login-key"
see "CONNECTION / MOLT-VM"
escape
see "CONNECTIONS"
escape
see "WORKSPACES"
palette 2
see "GUIDED SETUP"
enter
see "SETUP FOLDERS"
value "$env(TUI_TMP)/repos"
see "Remote workspace"
enter
see "PREPARE VM?"
send -- "y"
see "SESSION / bootstrap"
see "SETUP COMPLETE"
if {![file exists "$env(TUI_TMP)/vm/molt/.install-manifest"]} { puts stderr "FAIL: native setup did not prepare its VM workspace"; exit 1 }
if {[exec /bin/bash "$env(MOLT_HOME)/bin/molt" config get MOLT_ROOT]!="$env(TUI_TMP)/repos"} { puts stderr "FAIL: project folder was not saved"; exit 1 }
escape
see "WORKSPACES"
palette 9
see "UNINSTALL"
down 1
enter
see "REMOVE MOLT?"
send -- "y"
expect eof
catch wait result
if {[lindex $result 3]!=0} { puts stderr "FAIL: guided lifecycle returned $result"; exit 1 }
