#!/usr/bin/expect -f
# Real Bubble Tea/CLI; isolated repositories, SSH and tools.
set timeout 15
log_user 0
if {[info exists env(TUI_TEST_LOG)]} { log_file -a -noappend $env(TUI_TEST_LOG) }
proc see {text} {
  global spawn_id expect_out
  expect {
    -ex $text { return }
    timeout { puts stderr "FAIL: native TUI did not show '$text'\n$expect_out(buffer)"; exit 1 }
    eof { puts stderr "FAIL: native TUI exited before '$text'"; exit 1 }
  }
}
proc enter {} { global spawn_id; send -- "\r"; after 150 }
proc down {count} { global spawn_id; for {set i 0} {$i<$count} {incr i} { send -- "\033\[B"; after 80 } }
proc escape {} { global spawn_id; send -- "\033"; after 250 }
proc palette {index} { global spawn_id; send -- ":"; see "COMMANDS"; down $index; enter }
spawn -noecho /bin/bash "$env(TUI_ROOT)/tests/terminal_check.sh" /bin/bash "$env(MOLT_HOME)/bin/molt" tui
stty rows 32 columns 100 < $spawn_out(slave,name)
see "control center"
see "WORKSPACES"
# Help is grouped and command descriptions stay accessible.
send -- "?"
see "NAVIGATION"
see "Esc"
escape
send -- ":"
see "COMMANDS"
see "Scan, register, and manage"
send -- "i"
see "DETAILS"
escape
see "COMMANDS"
escape
# Scanning stays in Bubble Tea and registers the selected real Git checkout.
palette 0
see "REPOSITORIES"
enter
see "SCAN REPOSITORIES"
enter
see "SCAN RESULTS"
see "service"
down 1
enter
see "REGISTER REPOSITORY"
see "COMPLETED"
enter
see "REPOSITORIES"
escape
see "WORKSPACES"
if {[catch {exec /bin/bash "$env(MOLT_HOME)/bin/molt" project-find "$env(TUI_TMP)/repos/service"}]} { puts stderr "FAIL: scan selection was not registered"; exit 1 }
# Existing SSH aliases resolve using the real CLI, including included configs.
palette 1
see "CONNECTIONS"
down 1
enter
see "EXISTING SSH ALIASES"
see "ubuntu@vm.example:22"
down 1
see "developer@alternate.example:2222"
escape
see "CONNECTIONS"
down 1
enter
see "EXISTING SSH ALIASES"
down 1
see "developer@alternate.example:2222"
enter
see "CONNECTION / ALTERNATE-VM"
if {[exec /bin/bash "$env(MOLT_HOME)/bin/molt" config get MOLT_HOST] != "alternate-vm"} { puts stderr "FAIL: alias selection was not saved"; exit 1 }
escape
see "CONNECTIONS"
escape
see "WORKSPACES"
# Password input goes to an embedded PTY, never to the dashboard shortcuts.
send -- "c"
see "SESSION / SSH"
see "Fixture SSH password:"
send -- "quiet-secret\r"
see "COMPLETED"
see "Fixture login accepted"
enter
see "WORKSPACES"
# Cancel a hung background authentication check and its process group.
close [open "$env(TUI_TMP)/hold-ssh" w]
send -- "d"
see "CHECK CONNECTION"
for {set i 0} {$i<40 && ![file exists "$env(TUI_TMP)/held.pid"]} {incr i} { after 100 }
if {![file exists "$env(TUI_TMP)/held.pid"]} { puts stderr "FAIL: connection check never started"; exit 1 }
escape
see "WORKSPACES"
set file [open "$env(TUI_TMP)/held.pid" r]
set pid [string trim [read $file]]
close $file
after 300
if {![catch {exec kill -0 $pid}]} { puts stderr "FAIL: cancellation left its SSH child"; exit 1 }
file delete "$env(TUI_TMP)/hold-ssh"
# Settings use native forms, save through the CLI, and remain usable after resize.
palette 4
see "SETTINGS"
enter
see "PROJECT FOLDER"
escape
see "SETTINGS"
enter
see "PROJECT FOLDER"
send -- "\025$env(TUI_TMP)/repos\r"
see "SETTINGS"
down 4
enter
see "Animations: On"
down 4
enter
see "Animations: Off"
stty rows 14 columns 42 < $spawn_out(slave,name)
after 300
escape
send -- "3"
see "WORKSPACES"
stty rows 32 columns 100 < $spawn_out(slave,name)
after 300
# Registered-only removal works when every SSH request fails.
close [open "$env(TUI_TMP)/offline-ssh" w]
close [open "$env(TUI_TMP)/ssh.log" w]
palette 0
see "REPOSITORIES"
down 3
enter
see "SERVICE"
down 4
enter
see "REMOVE PROJECT"
send -- "n"
see "SERVICE"
down 4
enter
see "REMOVE PROJECT"
send -- "y"
see "COMPLETED"
enter
see "REPOSITORIES"
if {![catch {exec /bin/bash "$env(MOLT_HOME)/bin/molt" project-find "$env(TUI_TMP)/repos/service"}]} { puts stderr "FAIL: offline removal kept registration"; exit 1 }
set file [open "$env(TUI_TMP)/ssh.log" r]
set sshlog [read $file]
close $file
if {[string first "SSH connection ready" $sshlog]>=0} { puts stderr "FAIL: untouched removal tested SSH"; exit 1 }
# Previously provisioned projects expose an offline option and warn before removal.
set id [string trim [exec /bin/bash "$env(MOLT_HOME)/bin/molt" project-find "$env(TUI_TMP)/repos/app"]]
foreach {field value} [list remote_home /remote/molt remote_path /remote/molt/projects/$id remote_meta /remote/molt/meta/$id] {
  set file [open "$env(MOLT_HOME)/projects/$id/$field" w]
  puts $file $value
  close $file
}
down 2
enter
see "APP"
down 4
enter
see "Remove project locally only"
down 1
enter
see "VM resources may remain running"
send -- "n"
see "APP"
down 4
enter
see "Remove project locally only"
down 1
enter
see "VM resources may remain running"
send -- "y"
see "COMPLETED"
enter
see "REPOSITORIES"
escape
see "WORKSPACES"
# Destructive actions require an explicit confirmation; cancel preserves state.
send -- "q"
expect eof
catch wait result
if {[lindex $result 3]!=0} { puts stderr "FAIL: dashboard terminal restoration returned $result"; exit 1 }
# Compatibility menu entrypoints must also open Bubble Tea with old env settings.
set env(MOLT_TUI) legacy
spawn -noecho /bin/bash "$env(TUI_ROOT)/tests/terminal_check.sh" /bin/bash "$env(MOLT_HOME)/bin/molt" menu uninstall
stty rows 32 columns 100 < $spawn_out(slave,name)
see "UNINSTALL"
down 1
enter
see "REMOVE MOLT?"
send -- "n"
see "UNINSTALL"
if {![file exists "$env(MOLT_HOME)"]} { puts stderr "FAIL: cancelled uninstall removed state"; exit 1 }
down 3
enter
see "REMOVE MOLT?"
see "VM resources may remain running"
send -- "y"
expect eof
catch wait result
if {[lindex $result 3]!=0} { puts stderr "FAIL: native uninstall/terminal restoration returned $result"; exit 1 }
file delete "$env(TUI_TMP)/offline-ssh"
