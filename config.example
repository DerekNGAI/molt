# Copy to ~/.molt/config and edit.
# Sourced by molt and its shims. Do not put secrets in this file.

MOLT_HOST=oci-dev
MOLT_ROOT="$HOME/src"
MOLT_REMOTE_ROOT='$HOME/molt/projects'       # expanded on the VM
MOLT_REMOTE_META_ROOT='$HOME/molt/meta'      # expanded on the VM

# Each project gets a deterministic OpenCode port in this range on the VM.
MOLT_OPENCODE_BASE_PORT=4100

# File containing only the OpenCode server password (chmod 600).
MOLT_OPENCODE_PASSWORD_FILE="${MOLT_OPENCODE_PASSWORD_FILE:-$MOLT_HOME/opencode.password}"

# Ports we never try to forward from the VM.
MOLT_PORT_DENY='22 53 111 631'

# Poll for new ports until the attached remote command exits.
MOLT_PORT_POLL=1
