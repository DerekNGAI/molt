# Copy to ~/.molt/config and edit.
# Sourced by molt. Do not put secrets in this file.

MOLT_HOST=''                               # select a connection in the console
MOLT_ROOT="$HOME/src"
MOLT_REMOTE_HOME='$HOME/molt'                # one owned root, expanded on the VM

# Each project gets a deterministic OpenCode port in this range on the VM.
MOLT_OPENCODE_BASE_PORT=4100

# File containing only the OpenCode server password (chmod 600).
MOLT_OPENCODE_PASSWORD_FILE="${MOLT_OPENCODE_PASSWORD_FILE:-$MOLT_HOME/opencode.password}"

# Set to 0 for an instant, static terminal interface.
MOLT_ANIMATIONS=1
