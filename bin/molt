#!/usr/bin/env bash
# molt — one remote OpenCode server per repository.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/_molt.sh"
if [[ -f "${SCRIPT_DIR%/*}/.install-manifest" ]]; then
  MOLT_HOME="${MOLT_HOME:-${SCRIPT_DIR%/*}}"
else MOLT_HOME="${MOLT_HOME:-$HOME/.molt}"; fi
molt_safe_home || exit 1
CONFIG_FILE="$MOLT_HOME/config"
if [[ -f "$CONFIG_FILE" ]]; then source "$CONFIG_FILE";
elif [[ -f "$SCRIPT_DIR/../config.example" ]]; then source "$SCRIPT_DIR/../config.example"; fi
MOLT_HOST="${MOLT_HOST:-}"
MOLT_ROOT="${MOLT_ROOT:-$HOME/src}"
MOLT_REMOTE_HOME="${MOLT_REMOTE_HOME:-\$HOME/molt}"
MOLT_OPENCODE_PASSWORD_FILE="${MOLT_OPENCODE_PASSWORD_FILE:-$MOLT_HOME/opencode.password}"
MOLT_OPENCODE_BASE_PORT="${MOLT_OPENCODE_BASE_PORT:-4100}"
MOLT_ANIMATIONS="${MOLT_ANIMATIONS:-1}"
MOLT_PROJECTS_HOME="${MOLT_PROJECTS_HOME:-$MOLT_HOME/projects}"
[[ "$(molt_canonical "$MOLT_PROJECTS_HOME")" == "$MOLT_HOME/projects" ]] || { molt_error 'project state must be under MOLT_HOME/projects'; exit 1; }
case "$(molt_canonical "$MOLT_OPENCODE_PASSWORD_FILE")" in "$MOLT_HOME/"*) ;; *) molt_error 'password must be inside MOLT_HOME'; exit 1 ;; esac
MOLT_CONFIG_HOST="$MOLT_HOST"
MOLT_INSTALL_ID="$(molt_value "$MOLT_HOME/.install-manifest" INSTALL_ID 2>/dev/null || printf development)"
export MOLT_INSTALL_ID MOLT_SSH_CONFIG="${MOLT_SSH_CONFIG:-}"
mutagen() { molt_mutagen "$@"; }
ssh() { need_connection "$MOLT_HOST"; molt_ssh "$@"; }
log() { printf 'molt: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing $1"; }
need_connection() { [[ -n "$1" ]] || die 'no connection configured; choose Connections in MOLT or run molt connection use <alias>'; }
quote_remote() {
  local out='' arg
  for arg in "$@"; do out="${out:+$out }$(printf '%q' "$arg")"; done
  printf '%s' "$out"
}
read_value() {
  local value='' file="$1"
  [[ -f "$file" ]] || return 1
  IFS= read -r value <"$file" || true
  printf '%s\n' "$value"
}
write_value() { mkdir -p "$(dirname "$1")"; printf '%s\n' "$2" >"$1"; }
canonical_path() { (cd "$1" 2>/dev/null && pwd -P) || die "directory not found: $1"; }
repo_root() {
  local path="${1:-.}"
  if [[ "$path" == @* ]]; then
    [[ "${path#@}" =~ ^[a-f0-9]{12}$ ]] || die 'invalid project identity'
    path="$(read_value "$MOLT_PROJECTS_HOME/${path#@}/path")" || die 'project is not registered'
  fi
  path="$(canonical_path "$path")"
  git -C "$path" rev-parse --show-toplevel 2>/dev/null || die "not a Git repository: $path"
}
project_id_for_path() { printf '%s' "$(repo_root "$1")" | shasum -a 256 | cut -c1-12; }

load_project_state() {
  local state="$1"
  [[ -f "$state/path" ]] || return 1
  PROJECT_STATE="$state"
  PROJECT_ID="$(basename "$state")"
  [[ "$PROJECT_ID" =~ ^[a-f0-9]{12}$ && ! -L "$state" ]] || die 'invalid project state directory'
  PROJECT_PATH="$(read_value "$state/path")"
  PROJECT_NAME="$(read_value "$state/name")"
  PROJECT_REMOTE_PATH="$(read_value "$state/remote_path")"
  PROJECT_REMOTE_META="$(read_value "$state/remote_meta")"
  PROJECT_REMOTE_OPENCODE_CONFIG="$(read_value "$state/remote_opencode_config" 2>/dev/null || true)"
  PROJECT_CONTAINER="$(read_value "$state/container")"
  PROJECT_IMAGE="$(read_value "$state/image")"
  PROJECT_SYNC="$(read_value "$state/sync")"
  PROJECT_OPENCODE_PORT="$(read_value "$state/opencode_port")"
  PROJECT_ACTIVE="$(read_value "$state/active")"
  PROJECT_HOST="$(read_value "$state/host" 2>/dev/null || printf '%s' "$MOLT_CONFIG_HOST")"
  MOLT_HOST="$PROJECT_HOST"
  PROJECT_LAYOUT="$(read_value "$state/layout" 2>/dev/null || printf legacy)"
  PROJECT_REMOTE_HOME="$(read_value "$state/remote_home" 2>/dev/null || true)"
  PROJECT_SYNC_CREATED="$(read_value "$state/sync_created" 2>/dev/null || { [[ -z "$PROJECT_REMOTE_PATH" ]] && printf 0 || printf 1; })"
  PROJECT_RUNTIME_VERSION="$(read_value "$state/runtime_version" 2>/dev/null || true)"
  PROJECT_SETUP_STATE="$(read_value "$state/setup_state" 2>/dev/null || true)"
  case "$PROJECT_SETUP_STATE" in
    started|complete) ;;
    ''|untouched)
      PROJECT_SETUP_STATE=untouched
      if [[ -n "$PROJECT_REMOTE_PATH$PROJECT_REMOTE_META$PROJECT_REMOTE_HOME$PROJECT_REMOTE_OPENCODE_CONFIG" || "$PROJECT_ACTIVE" != 0 || "$PROJECT_SYNC_CREATED" != 0 || -e "$state/setup_state" && ! -r "$state/setup_state" ]]; then
        PROJECT_SETUP_STATE=started
      fi ;;
    *) PROJECT_SETUP_STATE=started ;;
  esac
}
load_project() {
  local path="${1:-.}"
  if [[ "$path" == @* ]]; then
    [[ "${path#@}" =~ ^[a-f0-9]{12}$ ]] || die 'invalid project identity'
    load_project_state "$MOLT_PROJECTS_HOME/${path#@}"
  else load_project_state "$MOLT_PROJECTS_HOME/$(project_id_for_path "$path")"; fi
}
save_project() {
  mkdir -p "$PROJECT_STATE"
  write_value "$PROJECT_STATE/path" "$PROJECT_PATH"
  write_value "$PROJECT_STATE/name" "$PROJECT_NAME"
  write_value "$PROJECT_STATE/remote_path" "$PROJECT_REMOTE_PATH"
  write_value "$PROJECT_STATE/remote_meta" "$PROJECT_REMOTE_META"
  write_value "$PROJECT_STATE/remote_opencode_config" "$PROJECT_REMOTE_OPENCODE_CONFIG"
  write_value "$PROJECT_STATE/container" "$PROJECT_CONTAINER"
  write_value "$PROJECT_STATE/image" "$PROJECT_IMAGE"
  write_value "$PROJECT_STATE/sync" "$PROJECT_SYNC"
  write_value "$PROJECT_STATE/opencode_port" "$PROJECT_OPENCODE_PORT"
  write_value "$PROJECT_STATE/active" "$PROJECT_ACTIVE"
  write_value "$PROJECT_STATE/host" "$PROJECT_HOST"
  write_value "$PROJECT_STATE/layout" "$PROJECT_LAYOUT"
  write_value "$PROJECT_STATE/remote_home" "$PROJECT_REMOTE_HOME"
  write_value "$PROJECT_STATE/sync_created" "$PROJECT_SYNC_CREATED"
  write_value "$PROJECT_STATE/runtime_version" "$PROJECT_RUNTIME_VERSION"
  write_value "$PROJECT_STATE/setup_state" "$PROJECT_SETUP_STATE"
  rm -f "$PROJECT_STATE/"{runtime,package_manager,generated_env,ports,sync_ignores}
}
register_project() {
  local path id state port candidate used offset
  path="$(repo_root "$1")"
  id="$(project_id_for_path "$path")"
  state="$MOLT_PROJECTS_HOME/$id"
  if [[ -f "$state/path" ]]; then load_project_state "$state"; return; fi
  need_connection "$MOLT_CONFIG_HOST"
  [[ ! -L "$state" ]] || die 'symlinked project state directory'
  valid_port "$MOLT_OPENCODE_BASE_PORT" && (( 10#$MOLT_OPENCODE_BASE_PORT >= 1024 && 10#$MOLT_OPENCODE_BASE_PORT <= 65036 )) || die 'invalid OpenCode base port'
  # Allocate from the existing range without assigning two projects the same tunnel.
  for offset in {0..499}; do
    port="$((10#$MOLT_OPENCODE_BASE_PORT + (16#${id:0:4} + offset) % 500))"
    used=0
    for candidate in "$MOLT_PROJECTS_HOME"/*/opencode_port; do
      [[ ! -f "$candidate" || "$(read_value "$candidate")" != "$port" ]] || used=1
    done
    [[ "$used" != 0 ]] || break
  done
  [[ "$used" == 0 ]] || die 'OpenCode port range is full'
  PROJECT_STATE="$state" PROJECT_ID="$id" PROJECT_PATH="$path" PROJECT_NAME="$(basename "$path")"
  PROJECT_REMOTE_PATH='' PROJECT_REMOTE_META='' PROJECT_REMOTE_OPENCODE_CONFIG='' PROJECT_REMOTE_HOME=''
  PROJECT_CONTAINER="molt-${MOLT_INSTALL_ID:0:8}-$id"
  PROJECT_IMAGE="molt-env-${MOLT_INSTALL_ID:0:8}-$id:latest"
  PROJECT_SYNC="$PROJECT_CONTAINER" PROJECT_OPENCODE_PORT="$port"
  PROJECT_HOST="$MOLT_CONFIG_HOST" MOLT_HOST="$MOLT_CONFIG_HOST"
  PROJECT_ACTIVE=0 PROJECT_LAYOUT=2 PROJECT_SYNC_CREATED=0 PROJECT_RUNTIME_VERSION=''
  PROJECT_SETUP_STATE=untouched
  save_project
}
cmd_setup_state() {
  local state candidate result=untouched
  [[ $# -le 1 ]] || die 'molt setup-state [repo]'
  if [[ $# == 1 ]]; then
    load_project "$1" || die 'project is not registered'
    printf '%s\n' "$PROJECT_SETUP_STATE"
    return
  fi
  for state in "$MOLT_PROJECTS_HOME"/*/path; do
    [[ -f "$state" ]] || continue
    load_project_state "${state%/path}" || return 1
    case "$PROJECT_SETUP_STATE" in
      started) result=started ;;
      complete) [[ "$result" != untouched ]] || result=complete ;;
    esac
  done
  for state in "$MOLT_HOME/state/remotes"/*/host; do
    [[ -f "$state" ]] || continue
    candidate="$(read_value "${state%/*}/setup_state" 2>/dev/null || printf started)"
    if [[ "$candidate" != complete ]]; then result=started;
    elif [[ "$result" == untouched ]]; then result=complete; fi
  done
  for state in "$MOLT_HOME/state/ssh/profiles"/*/authorized; do
    [[ ! -e "$state" && ! -L "$state" ]] || result=started
  done
  printf '%s\n' "$result"
}
find_project_for_path() {
  local path state project_path best='' best_path=''
  path="$(canonical_path "${1:-.}")"
  for state in "$MOLT_PROJECTS_HOME"/*/path; do
    [[ -f "$state" ]] || continue
    project_path="$(read_value "$state")"
    case "$path" in "$project_path"|"$project_path"/*)
      if [[ ${#project_path} -gt ${#best_path} ]]; then best="${state%/path}"; best_path="$project_path"; fi ;;
    esac
  done
  [[ -n "$best" ]] || return 1
  printf '%s\n' "$best"
}
cmd_project_find() { local state; state="$(find_project_for_path "${1:-.}")" || return 1; basename "$state"; }
project_active_for_path() { local state; state="$(find_project_for_path "${1:-.}")" || return 1; [[ "$(read_value "$state/active")" == 1 ]]; }
ssh_ok() { [[ -n "$MOLT_HOST" ]] && ssh -O check "$MOLT_HOST" >/dev/null 2>&1; }
ssh_up() { need ssh; ssh_ok && return 0; ssh -fN "$MOLT_HOST" || { log "ssh $MOLT_HOST failed"; return 1; }; }
ssh_down() { [[ "${MOLT_UNINSTALLING:-0}" != 1 ]] || return 0; if ssh_ok; then ssh -O exit "$MOLT_HOST"; fi; }
remote_run() { ssh "$MOLT_HOST" "$1"; }
remote_home() { ssh_up || return 1; remote_run 'printf %s "$HOME"'; }
expand_remote_path() {
  local path="$1" home="$2"
  case "$path" in
    '$HOME'/*) printf '%s/%s\n' "$home" "${path#\$HOME/}" ;; '$HOME'|'~') printf '%s\n' "$home" ;;
    '~'/*) printf '%s/%s\n' "$home" "${path#\~/}" ;; /*) printf '%s\n' "$path" ;; *) printf '%s/%s\n' "$home" "$path" ;;
  esac
}
upload_file() { remote_run "mkdir -p -- $(quote_remote "$(dirname "$2")")"; ssh "$MOLT_HOST" "cat > $(quote_remote "$2")" <"$1"; }
remote_script() { ssh "$MOLT_HOST" "bash -s -- $(quote_remote "$@")" <"$SCRIPT_DIR/_remote.sh"; }
cmd_setup() {
  local root home record field
  molt_owned_home || die 'install molt before preparing a VM'
  ssh_up || return 1
  home="$(remote_home)" || return 1
  root="$(expand_remote_path "${PROJECT_REMOTE_HOME:-$MOLT_REMOTE_HOME}" "$home")"
  root="$(remote_script validate-root "$root" "$MOLT_INSTALL_ID")" || die 'invalid remote workspace; configuration can be corrected before retrying'
  record="$MOLT_HOME/state/remotes/$(molt_host_key "$MOLT_HOST")"
  for field in host root setup_state; do managed_file "$record/$field"; done
  [[ ! -f "$record/root" || "$(read_value "$record/root")" == "$root" ]] || die 'remote root changed; clean up the recorded root before selecting another'
  write_value "$record/host" "$MOLT_HOST"
  write_value "$record/root" "$root"
  # Record intent before a remote command: losing SSH does not prove it did nothing.
  write_value "$record/setup_state" started
  root="$(remote_script setup "$root" "$MOLT_INSTALL_ID")" || die 'remote setup failed; its record is retained'
  write_value "$record/root" "$root"
  write_value "$record/setup_state" complete
  log "VM ready: $MOLT_HOST:$root"
}
set_remote_paths() {
  PROJECT_REMOTE_HOME="$(read_value "$MOLT_HOME/state/remotes/$(molt_host_key "$PROJECT_HOST")/root")"
  PROJECT_REMOTE_PATH="$PROJECT_REMOTE_HOME/projects/$PROJECT_ID"
  PROJECT_REMOTE_META="$PROJECT_REMOTE_HOME/meta/$PROJECT_ID"
  PROJECT_REMOTE_OPENCODE_CONFIG="$PROJECT_REMOTE_HOME/config/opencode"
  PROJECT_SETUP_STATE=started
  save_project
}
scan_repositories() {
  local root git_dir
  root="$(canonical_path "$1")"
  if git -C "$root" rev-parse --show-toplevel 2>/dev/null; then return 0; fi
  find "$root" \( -path '*/node_modules' -o -path '*/.devenv' -o -path '*/target' -o -path '*/.venv' \) -prune \
    -o \( -type d -name .git -o -type f -name .git \) -print 2>/dev/null | while IFS= read -r git_dir; do
      git -C "${git_dir%/.git}" rev-parse --show-toplevel 2>/dev/null || true
    done | sort -u
}
cmd_register() { register_project "${1:-.}"; log "registered $PROJECT_NAME ($PROJECT_ID)"; printf '%s\n' "$PROJECT_STATE"; }
prepare_project_dirs() { remote_script prepare "$PROJECT_REMOTE_HOME" "$MOLT_INSTALL_ID" "$PROJECT_ID"; }
start_sync() {
  local sessions mode
  mutagen daemon start
  sessions="$(mutagen sync list --template '{{range .}}{{.Name}}{{"\n"}}{{end}}')"
  mode="$(read_value "$PROJECT_STATE/sync_mode" 2>/dev/null || true)"
  if [[ "$mode" != two-way-safe ]] && printf '%s\n' "$sessions" | grep -Fxq "$PROJECT_SYNC"; then
    # Terminate the old replica before it can overwrite server edits on resume.
    mutagen sync terminate "$PROJECT_SYNC"
    sessions=''
  fi
  PROJECT_SYNC_CREATED=1
  save_project
  if printf '%s\n' "$sessions" | grep -Fxq "$PROJECT_SYNC"; then mutagen sync resume "$PROJECT_SYNC";
  else
    mutagen sync create --name "$PROJECT_SYNC" --mode two-way-safe \
      --ignore node_modules --ignore .devenv --ignore .next --ignore dist --ignore build \
      --ignore target --ignore .venv --ignore venv --ignore __pycache__ \
      "$PROJECT_PATH" "$MOLT_HOST:$PROJECT_REMOTE_PATH" >"$PROJECT_STATE/sync.log" 2>&1 || {
        cat "$PROJECT_STATE/sync.log" >&2; die "could not start Mutagen session $PROJECT_SYNC";
      }
  fi
  write_value "$PROJECT_STATE/sync_mode" two-way-safe
  flush_project_sync
}
flush_project_sync() {
  local blocked
  mutagen sync flush "$PROJECT_SYNC" || return 1
  blocked="$(mutagen sync list "$PROJECT_SYNC" --template '{{range .}}{{if .SessionState}}{{if or .Conflicts .LastError}}blocked{{end}}{{end}}{{if .Alpha.EndpointState}}{{if or .Alpha.ScanProblems .Alpha.TransitionProblems}}blocked{{end}}{{end}}{{if .Beta.EndpointState}}{{if or .Beta.ScanProblems .Beta.TransitionProblems}}blocked{{end}}{{end}}{{end}}')" || return 1
  if [[ -n "$blocked" ]]; then
    log 'synchronization needs attention; run molt sync and resolve conflicts before continuing'
    return 1
  fi
}
cmd_sync() {
  load_project "${1:-.}" || die 'project is not registered'
  case "${2:-}" in
    '') mutagen sync list "$PROJECT_SYNC" ;;
    --json) mutagen sync list "$PROJECT_SYNC" --template '{{json .}}' ;;
    *) die 'molt sync [repo] [--json]' ;;
  esac
}
cmd_sync_preview() {
  [[ $# == 2 ]] || die 'molt sync-preview <repo> <conflict-path>'
  load_project "$1" || die 'project is not registered'
  molt_owned_home || return 1
  "$SCRIPT_DIR/molt-tui" sync-preview "$MOLT_HOME/bin/molt" "$MOLT_HOME" "@$PROJECT_ID" "$2"
}
cmd_sync_resolve() {
  [[ $# == 3 ]] || die 'molt sync-resolve <repo> <backup-folder> <mac|vm>'
  load_project "$1" || die 'project is not registered'
  molt_owned_home || return 1
  with_project_setup_lock "$SCRIPT_DIR/molt-tui" sync-resolve "$MOLT_HOME/bin/molt" "$MOLT_HOME" "@$PROJECT_ID" "$2" "$3"
}
cmd_sync_prepare() {
  load_project "${1:?project required}" || die 'project is not registered'
  [[ "$PROJECT_LAYOUT" == 2 && "$PROJECT_SYNC_CREATED" == 1 ]] || die 'no contained synchronization session'
  stop_project_writer || return 1
  mutagen sync pause "$PROJECT_SYNC" || return 1
  cancel_project_forwards
  PROJECT_ACTIVE=0
  save_project
}
cmd_sync_endpoint() {
  [[ $# -ge 3 && $# -le 4 ]] || die 'invalid synchronization endpoint arguments'
  load_project "$1" || die 'project is not registered'
  ssh_up || return 1
  case "$2" in
    read) remote_script sync-read "$PROJECT_REMOTE_HOME" "$MOLT_INSTALL_ID" "$PROJECT_ID" "$3" ;;
    write)
      local stage
      stage="$(remote_script sync-stage "$PROJECT_REMOTE_HOME" "$MOLT_INSTALL_ID")" || return 1
      if upload_file /dev/stdin "$stage/replacement.tar"; then
        remote_script sync-write "$PROJECT_REMOTE_HOME" "$MOLT_INSTALL_ID" "$PROJECT_ID" "$3" "${4:?expected hash required}" "$stage"
      else
        remote_script sync-clean "$PROJECT_REMOTE_HOME" "$MOLT_INSTALL_ID" "$stage" || true
        return 1
      fi ;;
    *) die 'invalid synchronization endpoint action' ;;
  esac
}
cmd_start() (
  local path
  path="$(repo_root "${1:-.}")"
  molt_owned_home || die 'install molt before starting a project'
  register_project "$path"
  with_project_setup_lock start_loaded_project
)
start_loaded_project() {
  local path="$PROJECT_PATH" work="$PROJECT_SETUP_WORK"
  [[ "$PROJECT_LAYOUT" == 2 ]] || die 'reset this legacy project before starting it with the contained layout'
  cmd_setup
  load_project "$path" || die 'could not load project state'
  set_remote_paths
  prepare_project_dirs
  start_sync
  sync_opencode_config
  log 'Building the OpenCode container…'
  dockerfile_for_project "$work/Dockerfile"
  upload_file "$work/Dockerfile" "$PROJECT_REMOTE_META/Dockerfile"
  upload_file "$SCRIPT_DIR/../tools.lock" "$PROJECT_REMOTE_META/tools.lock"
  remote_run "docker build --label io.molt.installation=$MOLT_INSTALL_ID --label io.molt.project=$PROJECT_ID --tag $(quote_remote "$PROJECT_IMAGE") --file $(quote_remote "$PROJECT_REMOTE_META/Dockerfile") $(quote_remote "$PROJECT_REMOTE_META") >/dev/null"
  sync_password
  ensure_container
  wait_opencode_ready
  forward_opencode_port
  PROJECT_ACTIVE=1 PROJECT_RUNTIME_VERSION="$MOLT_RUNTIME_VERSION"
  PROJECT_SETUP_STATE=complete
  save_project
  log "$PROJECT_NAME is ready — OpenCode on $MOLT_HOST"
}
stop_project_writer() {
  local running owner
  ssh_up || return 1
  running="$(remote_run "docker inspect -f '{{.State.Running}}' $(quote_remote "$PROJECT_CONTAINER") 2>/dev/null || true")" || return 1
  if [[ "$running" == true ]]; then
    if [[ "$PROJECT_LAYOUT" == 2 ]]; then
      owner="$(remote_run "docker inspect -f '{{index .Config.Labels \"io.molt.installation\"}}' $(quote_remote "$PROJECT_CONTAINER")")" || return 1
      [[ "$owner" == "$MOLT_INSTALL_ID" ]] || { log 'container ownership mismatch'; return 1; }
    fi
    remote_run "docker stop $(quote_remote "$PROJECT_CONTAINER")" || return 1
  fi
}
stop_loaded_project() {
  local sessions
  [[ "$PROJECT_ACTIVE" == 1 || -n "$PROJECT_REMOTE_PATH" ]] || return 0
  stop_project_writer || return 1
  if [[ "$PROJECT_LAYOUT" == 2 ]]; then
    if [[ "$PROJECT_SYNC_CREATED" == 1 ]]; then
      sessions="$(mutagen sync list --template '{{range .}}{{.Name}}{{"\n"}}{{end}}')" || return 1
      if printf '%s\n' "$sessions" | grep -Fxq "$PROJECT_SYNC"; then
        if [[ "$(read_value "$PROJECT_STATE/sync_mode" 2>/dev/null || true)" == two-way-safe ]]; then
          mutagen sync resume "$PROJECT_SYNC" || return 1
          flush_project_sync || return 1
        fi
        mutagen sync pause "$PROJECT_SYNC" || return 1
      fi
    fi
  else
    molt_legacy_mutagen sync pause "$PROJECT_SYNC" || return 1
  fi
  cancel_project_forwards
  PROJECT_ACTIVE=0
  save_project
  log "stopped $PROJECT_NAME"
}
cmd_stop_project() { load_project "${1:-.}" || return 0; stop_loaded_project; }
cmd_down() {
  local state failed=0
  for state in "$MOLT_PROJECTS_HOME"/*/path; do
    [[ -f "$state" ]] || continue
    load_project_state "${state%/path}" || { failed=1; continue; }
    stop_loaded_project || failed=1
    ssh_down || failed=1
  done
  return "$failed"
}
container_path_for_pwd() {
  case "$1" in "$PROJECT_PATH"/*) printf '/workspace/%s\n' "${1#"$PROJECT_PATH"/}" ;; *) printf '/workspace\n' ;; esac
}
run_loaded_project() {
  local current="$1" container_path tmp worker='' rc=0
  local -a ssh_flags=() docker_flags=(-i)
  shift
  ensure_project_container
  container_path="$(container_path_for_pwd "$current")"
  if [[ -t 0 && -t 1 ]]; then ssh_flags=(-t); docker_flags=(-it); fi
  tmp="$(mktemp -d "$MOLT_HOME/state/tmp/run.XXXXXX")"
  trap 'if [[ -n "$worker" ]]; then molt_kill_tree "$worker"; wait "$worker" 2>/dev/null || true; fi; rm -rf -- "$tmp"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  printf '%s\n' "$$" >"$tmp/parent.pid"
  printf '%s\n' "$0" >"$tmp/script"
  write_value "$tmp/project" "$PROJECT_ID"
  ssh ${ssh_flags[@]+"${ssh_flags[@]}"} "$MOLT_HOST" "docker exec ${docker_flags[*]} --workdir $(quote_remote "$container_path") $(quote_remote "$PROJECT_CONTAINER" "$@")" <&0 &
  worker=$!
  wait "$worker" || rc=$?
  rm -rf -- "$tmp"
  trap - EXIT INT TERM
  return "$rc"
}
cmd_status() {
  local state running
  if [[ -z "$MOLT_HOST" ]]; then printf 'molt: no connection configured\n';
  elif ssh_ok; then printf 'molt: ssh %s connected\n' "$MOLT_HOST"; else printf 'molt: ssh %s disconnected\n' "$MOLT_HOST"; fi
  for state in "$MOLT_PROJECTS_HOME"/*/path; do
    [[ -f "$state" ]] || continue
    load_project_state "${state%/path}"
    running=unknown
    if [[ "$PROJECT_ACTIVE" == 1 ]] && ssh_ok; then running="$(remote_run "docker inspect -f '{{.State.Running}}' $(quote_remote "$PROJECT_CONTAINER") 2>/dev/null || printf false")"; fi
    printf '%s  active=%s  container=%s  docker=%s\n' "$PROJECT_PATH" "$PROJECT_ACTIVE" "$PROJECT_CONTAINER" "$running"
  done
}
cmd_doctor() {
  local failed=0 command
  need_connection "$MOLT_HOST"
  for command in git ssh; do
    if command -v "$command" >/dev/null 2>&1; then printf 'ok   %s\n' "$command"; else printf 'miss %s\n' "$command"; failed=1; fi
  done
  if mutagen version >/dev/null 2>&1; then printf 'ok   mutagen\n'; else printf 'miss mutagen\n'; failed=1; fi
  if ssh -o BatchMode=yes "$MOLT_HOST" true >/dev/null 2>&1; then
    if ssh_up && remote_run 'command -v docker >/dev/null && docker info >/dev/null 2>&1'; then printf 'ok   %s Docker\n' "$MOLT_HOST";
    else printf 'miss %s Docker (choose Prepare VM in the console)\n' "$MOLT_HOST"; failed=1; fi
  else printf 'miss %s SSH (configure or test its connection in the console)\n' "$MOLT_HOST"; failed=1; fi
  return "$failed"
}
cmd_logs() { load_project "${1:-.}" || die 'project is not registered'; ssh_up; remote_run "docker logs --tail 200 $(quote_remote "$PROJECT_CONTAINER") 2>&1"; }

cleanup_project_remote_connected() {
  local root="${PROJECT_REMOTE_HOME:-}"
  [[ -n "$PROJECT_REMOTE_PATH" || -n "$PROJECT_REMOTE_META" || -n "$root" ]] || return 0
  [[ -n "$root" ]] || root="$(dirname "$(dirname "$PROJECT_REMOTE_PATH")")"
  remote_script cleanup "$root" "$MOLT_INSTALL_ID" "$PROJECT_ID" "$PROJECT_CONTAINER" "$PROJECT_IMAGE" "$PROJECT_REMOTE_PATH" "$PROJECT_REMOTE_META" "$PROJECT_LAYOUT" || return 1
  cancel_project_forwards
}
cleanup_project_remote() {
  [[ -n "$PROJECT_REMOTE_PATH" || -n "$PROJECT_REMOTE_META" || -n "$PROJECT_REMOTE_HOME" ]] || return 0
  ssh_up || return 1
  cleanup_project_remote_connected
}
terminate_project_sync() {
  local sessions local_only="${1:-0}"
  [[ "$PROJECT_SYNC_CREATED" == 1 ]] || return 0
  if [[ "$PROJECT_LAYOUT" == 2 ]]; then
    sessions="$(mutagen sync list --template '{{range .}}{{.Name}}{{"\n"}}{{end}}')" || return 1
    if printf '%s\n' "$sessions" | grep -Fxq "$PROJECT_SYNC"; then
      if [[ "$local_only" != 1 && "$(read_value "$PROJECT_STATE/sync_mode" 2>/dev/null || true)" == two-way-safe ]]; then
        mutagen sync resume "$PROJECT_SYNC" || return 1
        flush_project_sync || return 1
      fi
      mutagen sync terminate "$PROJECT_SYNC" || return 1
    fi
  else
    sessions="$(molt_legacy_mutagen sync list --template '{{range .}}{{.Name}}{{"\n"}}{{end}}')" || return 1
    if printf '%s\n' "$sessions" | grep -Fxq "$PROJECT_SYNC"; then molt_legacy_mutagen sync terminate "$PROJECT_SYNC" || return 1; fi
  fi
  PROJECT_SYNC_CREATED=0
  write_value "$PROJECT_STATE/sync_created" 0
}
reset_loaded_project() {
  local local_only="${1:-0}" record field pid previous_state="$PROJECT_SETUP_STATE"
  [[ "$PROJECT_STATE" == "$MOLT_HOME/projects/$PROJECT_ID" && ! -L "$PROJECT_STATE" ]] || return 1
  managed_file "$PROJECT_STATE"
  molt_stop_workers "$PROJECT_ID" || { log 'could not stop owned project processes; retry records retained'; return 1; }
  load_project_state "$PROJECT_STATE" || return 1
  if [[ -d "$PROJECT_STATE/start.lock" ]]; then
    pid="$(read_value "$PROJECT_STATE/start.lock/pid" 2>/dev/null || true)"
    if [[ ! "$pid" =~ ^[1-9][0-9]*$ ]] || kill -0 "$pid" 2>/dev/null; then
      log 'project startup is still running; cancel it before removing the project'
      return 1
    fi
  fi
  if [[ "$local_only" == 1 && "$previous_state" == untouched && "$PROJECT_SETUP_STATE" != untouched ]]; then
    warn_local_project_removal
    log 'project setup changed during removal; retry to review the warning'
    return 1
  fi
  [[ "$PROJECT_SETUP_STATE" != untouched ]] || local_only=1
  if [[ "$local_only" == 1 ]]; then
    if [[ "$PROJECT_SETUP_STATE" != untouched ]]; then
      record="$MOLT_HOME/state/remotes/$(molt_host_key "$PROJECT_HOST")"
      for field in host root setup_state; do managed_file "$record/$field"; done
      write_value "$record/host" "$PROJECT_HOST"
      [[ -f "$record/root" ]] || write_value "$record/root" "$PROJECT_REMOTE_HOME"
      [[ -f "$record/setup_state" ]] || write_value "$record/setup_state" started
    fi
    terminate_project_sync 1 || { log "could not terminate $PROJECT_SYNC; retry records retained"; return 1; }
    cancel_project_forwards
  else
    # Stop the writer before the final sync so cleanup cannot race server edits.
    if [[ "$PROJECT_LAYOUT" == 2 ]]; then
      stop_loaded_project || { log 'could not stop and synchronize the server; retry records retained'; return 1; }
    fi
    terminate_project_sync || { log "could not terminate $PROJECT_SYNC; retry records retained"; return 1; }
    cleanup_project_remote || { log "could not clean $PROJECT_NAME; retry records retained (use molt reset --local-only to remove locally)"; return 1; }
  fi
  rm -rf -- "$PROJECT_STATE" || return 1
  log "reset $PROJECT_NAME"
}
cmd_reset_all() {
  local state answer failed=0 count=0 touched=0 local_only="${1:-0}"
  for state in "$MOLT_PROJECTS_HOME"/*/path; do
    [[ -f "$state" ]] || continue
    count=$((count + 1))
    load_project_state "${state%/path}" || return 1
    if [[ "$PROJECT_SETUP_STATE" != untouched ]]; then touched=1; fi
  done
  [[ "$count" -gt 0 ]] || return 0
  if [[ "$local_only" == 1 && "$touched" == 1 ]]; then warn_local_project_removal; fi
  if [[ "${MOLT_ASSUME_YES:-0}" == 1 ]]; then answer=y;
  else
    if [[ "$local_only" == 1 ]]; then printf 'Remove all projects locally only? [y/N] ';
    else printf 'Remove all project resources and local molt state? [y/N] '; fi
    read -r answer || return 0
  fi
  [[ "$answer" == y || "$answer" == Y ]] || return 0
  for state in "$MOLT_PROJECTS_HOME"/*/path; do
    [[ -f "$state" ]] || continue
    load_project_state "${state%/path}" || { failed=1; continue; }
    reset_loaded_project "$local_only" || failed=1
  done
  if [[ "$local_only" != 1 && "$touched" == 1 ]]; then ssh_down || failed=1; fi
  return "$failed"
}
cmd_remove_remote_roots() {
  local state root failed=0 action=remove-root
  [[ $# -le 1 ]] || die 'molt remove-remote-roots [--keep-root]'
  case "${1:-}" in --keep-root) action=clean-root ;; '') ;; *) die 'molt remove-remote-roots [--keep-root]' ;; esac
  for state in "$MOLT_HOME/state/remotes"/*/host; do
    [[ -f "$state" ]] || continue
    MOLT_HOST="$(read_value "$state")"
    root="$(read_value "${state%/*}/root")"
    if remote_script "$action" "$root" "$MOLT_INSTALL_ID"; then
      [[ "$action" == remove-root ]] || continue
      ssh_down || failed=1
      rm -rf -- "${state%/*}" || failed=1
    else failed=1; fi
  done
  return "$failed"
}
cmd_reset() {
  local answer ref=. has_ref=0 all=0 local_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) all=1 ;;
      --local-only) local_only=1 ;;
      -*) die 'molt reset [repo|--all] [--local-only]' ;;
      *) [[ "$has_ref" == 0 ]] || die 'molt reset [repo|--all] [--local-only]'; ref="$1"; has_ref=1 ;;
    esac
    shift
  done
  [[ "$all" == 0 || "$has_ref" == 0 ]] || die 'a repository cannot be combined with --all'
  if [[ "$all" == 1 ]]; then cmd_reset_all "$local_only"; return $?; fi
  load_project "$ref" || return 0
  if [[ "$local_only" == 1 && "$PROJECT_SETUP_STATE" != untouched ]]; then warn_local_project_removal; fi
  if [[ "${MOLT_ASSUME_YES:-0}" == 1 ]]; then answer=y;
  else
    if [[ "$local_only" == 1 || "$PROJECT_SETUP_STATE" == untouched ]]; then printf 'Remove local registration and synchronization for %s? [y/N] ' "$PROJECT_NAME";
    else printf 'Remove the remote container, image, sync, and local molt state for %s? [y/N] ' "$PROJECT_NAME"; fi
    read -r answer || return 0
  fi
  [[ "$answer" == y || "$answer" == Y ]] || return 0
  reset_loaded_project "$local_only"
}
warn_local_project_removal() {
  log 'WARNING: VM resources may remain running, and remote edits will not be synchronized. Local-only removal discards project cleanup records; manual VM cleanup may be required.'
}
cmd_tui() {
  local screen=''
  local -a options
  [[ -t 0 && -t 1 ]] || die 'the control center needs an interactive terminal'
  if [[ ! -f "$MOLT_HOME/.install-manifest" ]]; then exec /bin/bash "$SCRIPT_DIR/../install.sh" --interactive; fi
  molt_owned_home || die 'not an owned installation'
  molt_state || die 'unsafe installation state'
  if [[ "${1:-}" == --screen ]]; then screen="${2:?screen required}"; shift 2; fi
  [[ $# -le 1 ]] || die 'molt tui [project-folder]'
  [[ $# == 0 ]] || cmd_config set MOLT_ROOT "$1"
  [[ -x "$SCRIPT_DIR/molt-tui" ]] || die 'Bubble Tea control center is missing; repair the installation with Go or MOLT_TUI_BINARY'
  options=(--cli "$MOLT_HOME/bin/molt" --home "$MOLT_HOME")
  [[ -z "$screen" ]] || options+=(--screen "$screen")
  exec "$SCRIPT_DIR/molt-tui" "${options[@]}"
}
cmd_menu() {
  [[ $# -le 1 ]] || die 'molt menu [screen]'
  case "${1:-}" in
    '') cmd_tui ;;
    projects|connections|setup|opencode|settings|maintenance|uninstall) cmd_tui --screen "$1" ;;
    *) die 'molt menu [projects|connections|setup|opencode|settings|maintenance|uninstall]' ;;
  esac
}
usage() {
  cat <<'USAGE'
molt — remote OpenCode workspaces

  molt                         open the local control center
  molt menu [screen]           open setup and management forms
  molt scan [root]             list Git repositories
  molt register [repo]         register a repository on the selected VM
  molt start [repo]            sync, build, and start its OpenCode server
  molt stop [repo]             stop its server and sync
  molt restart [repo]          stop, synchronize, and start its server
  molt up / down               start / stop registered projects
  molt oc [args]               auto-start and attach to this repo's server
  molt project-find [path]     print the closest registered project ID
  molt setup / bootstrap      prepare the VM; bootstrap can install Docker
  molt config [show|get|set]   manage settings (including MOLT_ANIMATIONS)
  molt connection [action]    manage SSH profiles and dedicated keys
  molt shell [enable|disable]  manage automatic Zsh activation
  molt status / doctor        show status / check prerequisites
  molt logs [repo]             show OpenCode server logs
  molt sync [repo]             show synchronization status and conflicts
  molt monitor [host <alias>|sync]  read machine status for the dashboard
  molt reset [repo|--all] [--local-only]  remove project resources, or only local registration and sync
  molt setup-state [repo]     read recorded VM/project setup state without SSH
  molt tools                  show tool versions
  molt update                 install the latest MOLT from main

  opencode [args]              auto-start and attach in registered repositories
  MOLT_LOCAL=1 opencode        run locally with your normal OpenCode state
USAGE
}
source "$SCRIPT_DIR/_manage.sh"
source "$SCRIPT_DIR/_docker.sh"
source "$SCRIPT_DIR/_opencode.sh"
source "$SCRIPT_DIR/_monitor.sh"
main() {
  local command="${1:-tui}" state profile ref
  shift || true
  case "$command" in
    tui) cmd_tui "$@" ;; menu) cmd_menu "$@" ;; monitor) cmd_monitor "$@" ;; scan) scan_repositories "${1:-$MOLT_ROOT}" ;;
    project-id) project_id_for_path "${1:-.}" ;; project-find) cmd_project_find "$@" ;; project-active) project_active_for_path "${1:-.}" ;;
    setup) cmd_setup ;; setup-state) cmd_setup_state "$@" ;; bootstrap) cmd_bootstrap ;; unprepare-vm) cmd_unprepare_vm ;;
    register) cmd_register "$@" ;; start) cmd_start "$@" ;; stop) cmd_stop_project "$@" ;;
    restart) cmd_stop_project "$@" && cmd_start "$@" ;;
    up) for state in "$MOLT_PROJECTS_HOME"/*/path; do [[ ! -f "$state" ]] || cmd_start "@$(basename "${state%/path}")"; done ;;
    down) cmd_down ;; status) cmd_status ;; doctor) cmd_doctor ;;
    config) cmd_config "$@" ;; connection) cmd_connection "$@" ;; shell) cmd_shell "$@" ;; tools) cmd_tools ;; update) cmd_update "$@" ;;
    ui-action) cmd_ui_action "$@" ;; remote-oc) cmd_remote_oc "$@" ;; server-config) cmd_server_config "$@" ;;
    ssh) ssh_up; ssh "$MOLT_HOST" "$@" ;;
    oc|opencode) cmd_oc "$@" ;;
    oc-project|opencode-connect)
      ref="${1:?project ID required}"
      [[ ! "$ref" =~ ^[a-f0-9]{12}$ ]] || ref="@$ref"
      load_project "$ref" || die 'project is not registered'; shift; attach_loaded_project /workspace "$@" ;;
    client) cmd_client "$@" ;;
    cleanup-inventory)
      for state in "$MOLT_PROJECTS_HOME"/*/path; do
        [[ -f "$state" ]] || continue
        load_project_state "${state%/path}"
        printf 'Remote host: %s\n  project: %s\n  metadata: %s\n  container: %s\n  image: %s\n' "$PROJECT_HOST" "$PROJECT_REMOTE_PATH" "$PROJECT_REMOTE_META" "$PROJECT_CONTAINER" "$PROJECT_IMAGE"
        [[ "$PROJECT_LAYOUT" == 2 ]] || printf '  legacy volume: molt-cache-%s\n' "$PROJECT_ID"
      done
      for state in "$MOLT_HOME/state/remotes"/*/host; do
        [[ ! -f "$state" ]] || printf 'Remote host: %s\n  root: %s\n' "$(read_value "$state")" "$(read_value "${state%/*}/root")"
      done
      for state in "$MOLT_HOME/state/ssh/profiles"/*/hostname; do
        [[ -f "$state" ]] || continue
        profile="${state%/*}"
        printf 'SSH connection %s: %s@%s:%s\n  identity: %s\n' "$(basename "$profile")" "$(read_value "$profile/user")" "$(read_value "$profile/hostname")" "$(read_value "$profile/port")" "$(read_value "$profile/identity")"
        if [[ -f "$profile/authorized" ]]; then printf '  Dedicated public key:\n'; read_value "$profile/authorized"; fi
      done ;;
    local-down)
      molt_stop_workers || exit 1
      molt_stop_daemon || exit 1
      for state in "$MOLT_HOME/state/ssh"/c-*; do
        [[ -S "$state" ]] || continue
        (cd "$MOLT_HOME/state/ssh" && command ssh -S "./$(basename "$state")" -O exit ignored-host) || exit 1
      done ;;
    logs) cmd_logs "$@" ;; sync) cmd_sync "$@" ;; reset) cmd_reset "$@" ;; remove-remote-roots) cmd_remove_remote_roots "$@" ;;
    sync-preview) cmd_sync_preview "$@" ;; sync-resolve) cmd_sync_resolve "$@" ;; sync-prepare) cmd_sync_prepare "$@" ;;
    sync-endpoint) cmd_sync_endpoint "$@" ;;
    sync-resume|sync-cycle)
      load_project "${1:?project required}" || die 'project is not registered'
      mutagen sync resume "$PROJECT_SYNC"
      [[ "$command" != sync-cycle ]] || mutagen sync flush "$PROJECT_SYNC" ;;
    help|-h|--help) usage ;; *) die "unknown command: $command (try molt help)" ;;
  esac
}
main "$@"
