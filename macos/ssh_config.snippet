# Append to ~/.ssh/config
#
# HostName can be a public IP or a Tailscale MagicDNS name.
# molt supplies its own connection-sharing, known-hosts, and port-forwarding
# settings, with all state inside MOLT_HOME.

Host oci-dev
  HostName REPLACE_ME
  User ubuntu
  IdentityFile ~/.ssh/oci_dev
  IdentitiesOnly yes
